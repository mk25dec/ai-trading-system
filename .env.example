# External Postgres (Coolify managed DB or other). Required for docker-compose.yml / production.
# Example shape — set the real value in Coolify env vars, never commit secrets.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable

# API
JWT_SECRET=generate-a-long-random-secret
CORS_ORIGIN=https://your-domain.example
SECURE_COOKIES=true
WEB_PORT=80

# Bootstrap platform admin (created on first startup if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# Local Vite dev only (not used by production web image)
VITE_API_URL=http://localhost:8080
