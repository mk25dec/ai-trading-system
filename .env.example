# Copy to `.env` at the repository root (gitignored). All local tools read this file.
#   cp .env.example .env
#
# Local: DATABASE_URL uses localhost (Go and Vite run on the host).
# Production: set real values in Coolify — see docs/runbooks/coolify-deploy.md

# --- Postgres (docker-compose.dev.yml + host Go/Vite) ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading
DATABASE_URL=postgres://trading:trading@localhost:5432/trading?sslmode=disable

# Coolify only: Docker network name — NOT the hostname inside DATABASE_URL
DATABASE_NETWORK_NAME=coolify

# --- API ---
API_PORT=8090
JWT_SECRET=generate-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
SECURE_COOKIES=false

# DuckDB analytics file (production volume at /data)
DUCKDB_PATH=/data/analytics.duckdb

# Bootstrap platform admin (created on first API startup if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# --- Web (Vite reads VITE_* from this file via envDir in web/vite.config.ts) ---
# Leave empty to use the dev-server proxy to the API (recommended for local).
VITE_API_URL=

# --- Pipeline / n8n ---
INTERNAL_API_KEY=generate-a-long-random-secret
API_INTERNAL_BASE_URL=http://localhost:8090
N8N_URL=https://n8n.example.com
N8N_API_KEY=
FINBERT_URL=https://finbert.example.com
FINBERT_API_URL=https://finbert.example.com
FINBERT_API_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_DATA_FEED=iex
# Trading API for symbol names (assets). Paper keys (PK…) → paper-api; live (AK…) → api.alpaca.markets
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
RSS_FEED_URL=https://finance.yahoo.com/news/rssindex
RSS_SOURCE=yahoo_finance_rss
