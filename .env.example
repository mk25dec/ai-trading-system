# External Postgres (Coolify managed DB or other). Required for docker-compose.yml / production.
# Example shape — set the real value in Coolify env vars, never commit secrets.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable

# Coolify: Docker *network* name (usually "coolify") — NOT the DB hostname in DATABASE_URL.
# Find via: docker inspect <postgres-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
DATABASE_NETWORK_NAME=coolify

# API (8090 avoids common 8080 conflicts on shared hosts)
API_PORT=8090
JWT_SECRET=generate-a-long-random-secret
CORS_ORIGIN=https://your-domain.example
SECURE_COOKIES=true

# DuckDB analytics file (mounted volume at /data in production)
DUCKDB_PATH=/data/analytics.duckdb

# Bootstrap platform admin (created on first startup if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login

# Local Vite dev only (not used by production web image)
VITE_API_URL=http://localhost:8090

# Pipeline / n8n
INTERNAL_API_KEY=generate-a-long-random-secret
API_INTERNAL_BASE_URL=http://api:8090
N8N_URL=https://n8n.example.com
N8N_API_KEY=
FINBERT_URL=https://finbert.example.com
FINBERT_API_URL=https://finbert.example.com
FINBERT_API_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets/v2
ALPACA_DATA_FEED=iex
# Trading API for symbol names (assets). Paper keys (PK…) → paper-api; live (AK…) → api.alpaca.markets
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=
ALPACA_API_SECRET=
FINNHUB_API_KEY=
RSS_FEED_URL=https://finance.yahoo.com/news/rssindex
RSS_SOURCE=yahoo_finance_rss
